{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "VisionGrep persistent benchmark prerequisites; no EC2 instances",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    }
  },
  "Resources": {
    "Reports": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "RunRetention",
              "Status": "Enabled",
              "Prefix": "runs/",
              "ExpirationInDays": 90
            }
          ]
        }
      }
    },
    "WorkerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "BenchmarkArtifacts",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Reports",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "${Reports.Arn}/artifacts/*"
                    },
                    {
                      "Fn::Sub": "${Reports.Arn}/runs/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Reports.Arn}/runs/*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "WorkerProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "WorkerRole"
          }
        ]
      }
    },
    "ExpiryRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "scheduler.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "TerminateBenchmarks",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ec2:TerminateInstances",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "ec2:ResourceTag/Project": "visiongrep-benchmark"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "WorkerSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Benchmark worker: no inbound access",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "-1",
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    }
  },
  "Outputs": {
    "Bucket": {
      "Value": {
        "Ref": "Reports"
      }
    },
    "InstanceProfile": {
      "Value": {
        "Ref": "WorkerProfile"
      }
    },
    "SchedulerRole": {
      "Value": {
        "Fn::GetAtt": [
          "ExpiryRole",
          "Arn"
        ]
      }
    },
    "SecurityGroup": {
      "Value": {
        "Ref": "WorkerSecurityGroup"
      }
    }
  }
}
